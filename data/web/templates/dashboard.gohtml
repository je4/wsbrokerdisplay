<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WSBroker Display - {{.ClientName}}</title>
    <!-- Tailwind CSS & HTMX Integration -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/htmx.org@2.0.11"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        kiosk: '#0b0f19',
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="/static/css/dashboard.css">
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between selection:bg-blue-600 selection:text-white p-4 sm:p-6 lg:p-8">

    <!-- Header Bar -->
    <header class="w-full max-w-7xl mx-auto flex flex-wrap items-center justify-between pb-6 mb-6 border-b border-gray-800/80 gap-4">
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center shadow-lg shadow-blue-500/20">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
            </div>
            <div>
                <h1 class="text-xl font-bold tracking-tight text-white flex items-center gap-2">
                    WSBroker Display
                    <span class="text-xs font-normal px-2 py-0.5 rounded bg-blue-950 text-blue-300 border border-blue-800">Kiosk Node</span>
                </h1>
                <p class="text-xs text-gray-400 font-mono">Client ID: <span class="text-gray-200 font-medium">{{.ClientName}}</span></p>
            </div>
        </div>

        <div class="flex items-center space-x-3">
            <a href="/swagger/index.html" class="px-3 py-1.5 text-xs font-medium rounded-lg bg-gray-900 text-gray-300 hover:text-white hover:bg-gray-800 border border-gray-700/80 transition-colors inline-flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                </svg>
                Swagger API
            </a>
            <div class="flex items-center space-x-2 px-3 py-1.5 bg-emerald-950/60 border border-emerald-800/80 rounded-lg text-emerald-300 text-xs font-medium">
                <span class="w-2 h-2 rounded-full bg-emerald-400 pulse-indicator"></span>
                <span>Controller Online</span>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="w-full max-w-7xl mx-auto flex-1 flex flex-col justify-center space-y-8">
        
        <!-- Live NTP-Synchronized Clock Hero -->
        <section class="text-center py-6 px-4 rounded-2xl bg-gradient-to-b from-gray-900/80 to-gray-950/80 border border-gray-800 shadow-2xl relative overflow-hidden">
            <div class="absolute inset-0 bg-blue-600/5 blur-3xl pointer-events-none"></div>
            
            <div class="relative z-10 flex flex-col items-center">
                <div id="ntp-status-badge" class="inline-flex items-center space-x-2 mb-2 px-3 py-1 rounded-full bg-gray-800/80 border border-gray-700/60 text-xs text-gray-300">
                    <span class="w-2 h-2 rounded-full {{if .NTP.Synced}}bg-emerald-400{{else}}bg-amber-400{{end}}"></span>
                    <span>{{if .NTP.Synced}}NTP Synchronized (Offset: {{.NTP.OffsetString}}){{else}}Awaiting NTP Synchronization{{end}}</span>
                </div>

                <!-- Digital Clock Display -->
                <div id="digital-clock" class="font-mono text-5xl sm:text-7xl lg:text-8xl font-bold tracking-tight text-white clock-display my-2">
                    --:--:--
                </div>

                <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-sm text-gray-400 mt-2">
                    <span id="digital-date" class="font-medium text-gray-200">Loading date...</span>
                    <span>•</span>
                    <span id="digital-timezone" class="font-mono text-gray-400">UTC</span>
                </div>
            </div>
        </section>

        <!-- Dynamic Metric Cards (HTMX polling every 10s) -->
        <section id="metric-cards-container" hx-get="/dashboard/cards" hx-trigger="every 10s" hx-swap="innerHTML">
            {{template "cards.gohtml" .}}
        </section>

    </main>

    <!-- Footer Bar -->
    <footer class="w-full max-w-7xl mx-auto pt-6 mt-8 border-t border-gray-800/80 flex flex-wrap justify-between items-center text-xs text-gray-500 gap-4">
        <div>
            WSBroker Display &copy; 2026 &bull; High-precision kiosk display & telemetry controller
        </div>
        <div class="flex items-center space-x-4 font-mono">
            <span>REST API: <span class="text-gray-400">{{.Addr}}</span></span>
            <span>&bull;</span>
            <span>Uptime: <span class="text-emerald-400">{{.Uptime}}</span></span>
        </div>
    </footer>

    <!-- Live Clock Script -->
    <script src="/static/js/dashboard.js"></script>
</body>
</html>
