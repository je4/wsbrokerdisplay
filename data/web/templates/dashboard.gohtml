<!DOCTYPE html>
<html lang="de" translate="no">
<head>
    <meta charset="UTF-8">
    <meta name="google" content="notranslate">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WSBroker Display - {{.ClientName}}</title>
    <!-- Automatic Theme & Dark / Light mode detection to prevent FOUC -->
    <script src="/static/js/theme-init.js"></script>
    <!-- Tailwind CSS, DaisyUI & HTMX 4 -->
    <link rel="stylesheet" href="/static/css/tailwind.min.css">
    <link rel="stylesheet" href="/static/css/daisyui.min.css">
    <script src="/static/js/htmx-4.0.js"></script>
    <link rel="stylesheet" href="/static/scss/dashboard.css">
</head>
<body class="app-body min-h-screen flex flex-col justify-between selection:bg-blue-600 selection:text-white p-4 sm:p-6 lg:p-8">

    <!-- Header Bar with Navigation & Actions -->
    <header class="navbar w-full max-w-7xl mx-auto flex flex-wrap items-center justify-between mb-6 app-header gap-4 p-0 min-h-0">
        <div class="flex items-center space-x-3.5">
            <!-- Dynamic Gradient Icon -->
            <div class="w-11 h-11 rounded-xl bg-primary text-primary-content flex items-center justify-center shadow-lg shadow-primary/25 shrink-0">
                <span class="app-icon icon-bolt w-6 h-6" aria-hidden="true"></span>
            </div>

            <div>
                <!-- Title & Status Badge -->
                <h1 class="text-xl font-bold tracking-tight app-title flex items-center gap-2.5">
                    WSBroker Display
                    <span class="badge badge-sm badge-outline app-badge-status transition-all">Kiosk Node</span>
                </h1>

                <!-- Metadata Row -->
                <p class="text-xs app-meta-text font-mono flex items-center gap-2">
                    <span>Client: <strong>{{.ClientName}}</strong></span>
                    {{if .WSBroker}}
                    <span>&bull;</span>
                    <span>Broker: <strong>{{.WSBroker}}</strong></span>
                    {{end}}
                </p>
            </div>
        </div>

        <!-- Top Right Actions & Theme Selector -->
        <div class="flex items-center space-x-3">
            <!-- Theme & Appearance Dialog Trigger Button -->
            <button id="theme-dialog-btn" type="button" class="btn btn-sm btn-ghost app-btn flex items-center gap-1.5" title="Design &amp; Farbschema anpassen (DaisyUI Themes)" aria-haspopup="dialog" aria-controls="theme-modal-dialog">
                <span class="app-icon icon-palette w-4 h-4 shrink-0" aria-hidden="true"></span>
                <span class="hidden sm:inline text-xs font-semibold">Design</span>
                <span id="theme-mode-indicator" class="badge badge-xs badge-outline font-mono text-[10px] uppercase">Auto</span>
                <span id="theme-name-indicator" class="badge badge-xs badge-primary font-mono text-[10px]">corporate</span>
            </button>

            <!-- Swagger API Documentation Button -->
            <a href="/swagger/index.html" class="btn btn-sm btn-ghost app-btn flex items-center gap-1.5" title="Swagger REST API Dokumentation">
                <span class="app-icon icon-external-link w-3.5 h-3.5 shrink-0" aria-hidden="true"></span>
                <span class="hidden sm:inline">Swagger API</span>
            </a>

            <!-- Controller Online Status Badge -->
            <div class="badge badge-sm gap-2 px-3 py-2.5 app-sse-badge connected">
                <span class="w-2 h-2 rounded-full bg-emerald-400 pulse-indicator"></span>
                <span class="font-medium text-emerald-400">Controller Online</span>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="app-main">
        
        <!-- Live NTP-Synchronized Clock Hero Panel -->
        <section class="app-panel text-center py-6 px-4 relative overflow-hidden">
            <div class="flex flex-col items-center relative z-10">
                <div id="ntp-status-badge" class="inline-flex items-center space-x-2 mb-2 px-3 py-1 rounded-full badge {{if .NTP.Synced}}badge-success bg-emerald-500/10 text-emerald-400 border-emerald-500/30{{else}}badge-warning bg-amber-500/10 text-amber-400 border-amber-500/30{{end}} text-xs font-medium">
                    <span class="w-2 h-2 rounded-full {{if .NTP.Synced}}bg-emerald-400 pulse-indicator{{else}}bg-amber-400{{end}}"></span>
                    <span>{{if .NTP.Synced}}NTP Synchronized (Offset: {{.NTP.OffsetString}}){{else}}Awaiting NTP Synchronization{{end}}</span>
                </div>

                <!-- Digital Clock Display -->
                <div id="digital-clock" class="font-mono text-5xl sm:text-7xl lg:text-8xl font-bold tracking-tight clock-display my-2">
                    --:--:--
                </div>

                <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-sm app-meta-text mt-2">
                    <span id="digital-date" class="font-medium">Lade Datum...</span>
                    <span>&bull;</span>
                    <span id="digital-timezone" class="font-mono">UTC</span>
                </div>
            </div>
        </section>

        <!-- Dynamic Metric Cards (HTMX polling every 10s) -->
        <section id="metric-cards-container" hx-get="/dashboard/cards" hx-trigger="every 10s" hx-swap="innerHTML">
            {{template "cards.gohtml" .}}
        </section>

    </main>

    <!-- Footer Bar -->
    <footer class="footer w-full max-w-7xl mx-auto mt-6 app-footer flex flex-wrap justify-between items-center text-xs gap-4 p-0">
        <div class="opacity-80">
            WSBroker Display &copy; 2026 &bull; High-precision kiosk display &amp; telemetry controller
        </div>
        <div class="flex items-center space-x-4 font-mono opacity-80">
            <span>REST API: <span class="server-addr">{{.Addr}}</span></span>
            <span>&bull;</span>
            <span>Uptime: <span class="text-emerald-400 font-semibold">{{.Uptime}}</span></span>
        </div>
    </footer>

    <!-- DaisyUI Theme Dialog -->
    {{template "theme_modal.gohtml" .}}

    <!-- Interactive Script (Clock & Theme Controller) -->
    <script type="module" src="/static/js/dashboard.js"></script>
</body>
</html>
