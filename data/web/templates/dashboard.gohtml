<!DOCTYPE html>
<html lang="de" translate="no" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="google" content="notranslate">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WSBroker Display - {{.ClientName}}</title>
    <!-- Automatic Dark / Light mode detection to prevent FOUC -->
    <script src="/static/js/theme-init.js"></script>
    <!-- Tailwind CSS, DaisyUI & HTMX 4 -->
    <link rel="stylesheet" href="/static/css/tailwind.min.css">
    <link rel="stylesheet" href="/static/css/daisyui.min.css">
    <script src="/static/js/htmx-4.0.js"></script>
    <link rel="stylesheet" href="/static/scss/dashboard.css">
</head>
<body class="bg-base-200 min-h-screen flex flex-col justify-between text-base-content p-4 sm:p-6 lg:p-8">

    <!-- Header / Navbar -->
    <header class="navbar bg-base-100 shadow-sm rounded-box w-full max-w-7xl mx-auto mb-6 px-4 py-2 gap-4">
        <div class="navbar-start flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-primary text-primary-content flex items-center justify-center shadow-sm shrink-0">
                <span class="app-icon icon-bolt w-5 h-5" aria-hidden="true"></span>
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <h1 class="text-lg font-bold tracking-tight">WSBroker Display</h1>
                    <span class="badge badge-sm badge-outline font-medium">Kiosk Node</span>
                </div>
                <p class="text-xs text-base-content/70 font-mono">
                    <span>Client: <strong>{{.ClientName}}</strong></span>
                    {{if .WSBroker}}
                    <span>&bull;</span>
                    <span>Broker: <strong>{{.WSBroker}}</strong></span>
                    {{end}}
                </p>
            </div>
        </div>

        <div class="navbar-end flex items-center gap-2">
            <!-- Swagger API Documentation Link -->
            <a href="/swagger/index.html" class="btn btn-sm btn-ghost gap-1.5" title="Swagger REST API Dokumentation">
                <span class="app-icon icon-external-link w-3.5 h-3.5 shrink-0" aria-hidden="true"></span>
                <span class="hidden sm:inline text-xs font-semibold">Swagger API</span>
            </a>

            <!-- Controller Online Status Badge -->
            <div class="badge badge-success badge-sm gap-1.5 px-3 py-2.5">
                <span class="w-2 h-2 rounded-full bg-success-content pulse-indicator"></span>
                <span class="font-medium">Controller Online</span>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="w-full max-w-7xl mx-auto flex-1 flex flex-col justify-center gap-6">
        
        <!-- Live NTP-Synchronized Clock Hero Panel -->
        <section class="hero bg-base-100 rounded-box border border-base-300 shadow-sm py-6 px-4">
            <div class="hero-content text-center flex-col p-0">
                <div id="ntp-status-badge" class="badge {{if .NTP.Synced}}badge-success{{else}}badge-warning{{end}} badge-sm gap-2 mb-1 font-medium">
                    <span class="w-2 h-2 rounded-full {{if .NTP.Synced}}bg-success-content pulse-indicator{{else}}bg-warning-content{{end}}"></span>
                    <span>{{if .NTP.Synced}}NTP Synchronized (Offset: {{.NTP.OffsetString}}){{else}}Awaiting NTP Synchronization{{end}}</span>
                </div>

                <!-- Digital Clock Display -->
                <div id="digital-clock" class="font-mono text-5xl sm:text-7xl lg:text-8xl font-bold tracking-tight text-primary my-2">
                    --:--:--
                </div>

                <div class="flex flex-wrap items-center justify-center gap-2 text-sm text-base-content/70">
                    <span id="digital-date" class="font-medium">Lade Datum...</span>
                    <span>&bull;</span>
                    <span id="digital-timezone" class="font-mono">UTC</span>
                </div>
            </div>
        </section>

        <!-- Dynamic Metric Cards (HTMX polling every 10s) -->
        <section id="metric-cards-container" hx-get="/dashboard/cards" hx-trigger="every 10s" hx-swap="innerHTML">
            {{template "cards.gohtml" .}}
        </section>

    </main>

    <!-- Footer Bar -->
    <footer class="footer bg-base-100 text-base-content p-4 rounded-box shadow-sm w-full max-w-7xl mx-auto mt-6 flex flex-wrap justify-between items-center text-xs gap-2">
        <div class="opacity-80">
            WSBroker Display &copy; 2026 &bull; High-precision kiosk display &amp; telemetry controller
        </div>
        <div class="flex items-center gap-3 font-mono opacity-80">
            <span>REST API: <span class="font-semibold">{{.Addr}}</span></span>
            <span>&bull;</span>
            <span>Uptime: <span class="text-success font-semibold">{{.Uptime}}</span></span>
        </div>
    </footer>

    <!-- Interactive Script (Clock Controller) -->
    <script type="module" src="/static/js/dashboard.js"></script>
</body>
</html>
