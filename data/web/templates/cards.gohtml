<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

    <!-- Card 1: Network Time (NTP) -->
    <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl">
        <div class="card-body p-4 sm:p-5 flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
                        <span class="app-icon icon-clock w-4 h-4" aria-hidden="true"></span>
                    </div>
                    <h2 class="card-title text-sm font-semibold m-0">Network Time (NTP)</h2>
                </div>
                {{if .NTP.Synced}}
                <span class="badge badge-success badge-sm gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-success-content pulse-indicator"></span>
                    <span>Synced</span>
                </span>
                {{else}}
                <span class="badge badge-warning badge-sm">Pending</span>
                {{end}}
            </div>

            <dl class="flex flex-col gap-1.5 text-xs">
                <div class="flex justify-between items-center py-0.5 border-b border-base-200/60">
                    <dt class="text-base-content/70">Server</dt>
                    <dd class="font-mono font-medium truncate max-w-[140px]" title="{{.NTP.Server}}">{{if .NTP.Server}}{{.NTP.Server}}{{else}}--{{end}}</dd>
                </div>
                <div class="flex justify-between items-center py-0.5 border-b border-base-200/60">
                    <dt class="text-base-content/70">Offset</dt>
                    <dd class="font-mono font-medium {{if .NTP.Synced}}text-success{{else}}text-warning{{end}}">{{if .NTP.OffsetString}}{{.NTP.OffsetString}}{{else}}--{{end}}</dd>
                </div>
                <div class="flex justify-between items-center py-0.5 border-b border-base-200/60">
                    <dt class="text-base-content/70">RTT</dt>
                    <dd class="font-mono font-medium">{{if .NTP.RTTString}}{{.NTP.RTTString}}{{else}}--{{end}}</dd>
                </div>
                <div class="flex justify-between items-center py-0.5">
                    <dt class="text-base-content/70">Stratum</dt>
                    <dd class="font-mono font-medium">{{if .NTP.Stratum}}{{.NTP.Stratum}}{{else}}--{{end}}</dd>
                </div>
            </dl>

            <div class="text-[11px] text-base-content/60 font-mono truncate border-t border-base-200 pt-2">
                Ref: {{if .NTP.ReferenceID}}{{.NTP.ReferenceID}}{{else}}--{{end}}
            </div>
        </div>
    </div>

    <!-- Card 2: WSBroker Client -->
    <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl">
        <div class="card-body p-4 sm:p-5 flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-secondary/10 text-secondary flex items-center justify-center shrink-0">
                        <span class="app-icon icon-channel w-4 h-4" aria-hidden="true"></span>
                    </div>
                    <h2 class="card-title text-sm font-semibold m-0">WSBroker Client</h2>
                </div>
                <span class="badge badge-secondary badge-sm">{{.TLSType}}</span>
            </div>

            <dl class="flex flex-col gap-1.5 text-xs">
                <div class="flex justify-between items-center py-0.5 border-b border-base-200/60">
                    <dt class="text-base-content/70">Client ID</dt>
                    <dd class="font-mono font-medium truncate max-w-[140px]" title="{{.ClientName}}">{{.ClientName}}</dd>
                </div>
                <div class="flex justify-between items-center py-0.5 border-b border-base-200/60">
                    <dt class="text-base-content/70">Broker URL</dt>
                    <dd class="font-mono font-medium truncate max-w-[140px]" title="{{.WSBroker}}">{{if .WSBroker}}{{.WSBroker}}{{else}}None{{end}}</dd>
                </div>
                <div class="flex justify-between items-center py-0.5 border-b border-base-200/60">
                    <dt class="text-base-content/70">Channels</dt>
                    <dd class="flex flex-wrap gap-1 justify-end max-w-[140px]">
                        {{range .Channels}}
                        <span class="badge badge-xs badge-outline font-mono">{{.}}</span>
                        {{else}}
                        <span class="font-mono text-base-content/50">None</span>
                        {{end}}
                    </dd>
                </div>
                <div class="flex justify-between items-center py-0.5">
                    <dt class="text-base-content/70">External</dt>
                    <dd class="font-mono font-medium truncate max-w-[140px]" title="{{.ExtAddr}}">{{.ExtAddr}}</dd>
                </div>
            </dl>

            <div class="text-[11px] text-base-content/60 font-mono truncate border-t border-base-200 pt-2">
                Listening: {{.Addr}}
            </div>
        </div>
    </div>

    <!-- Card 3: Display & Browser -->
    <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl">
        <div class="card-body p-4 sm:p-5 flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-accent/10 text-accent flex items-center justify-center shrink-0">
                        <span class="app-icon icon-external-link w-4 h-4" aria-hidden="true"></span>
                    </div>
                    <h2 class="card-title text-sm font-semibold m-0">Display &amp; Kiosk</h2>
                </div>
                {{if .BrowserConfig.Kiosk}}
                <span class="badge badge-accent badge-sm font-mono">Kiosk Mode</span>
                {{else}}
                <span class="badge badge-outline badge-sm font-mono">Windowed</span>
                {{end}}
            </div>

            <dl class="flex flex-col gap-1.5 text-xs">
                <div class="flex justify-between items-center py-0.5 border-b border-base-200/60">
                    <dt class="text-base-content/70">Resolution</dt>
                    <dd class="font-mono font-medium">{{.BrowserConfig.Width}} &times; {{.BrowserConfig.Height}}</dd>
                </div>
                <div class="flex justify-between items-center py-0.5 border-b border-base-200/60">
                    <dt class="text-base-content/70">Headless</dt>
                    <dd class="font-mono font-medium">{{if .BrowserConfig.Headless}}Yes{{else}}No{{end}}</dd>
                </div>
                <div class="flex justify-between items-center py-0.5 border-b border-base-200/60">
                    <dt class="text-base-content/70">Kiosk Flag</dt>
                    <dd class="font-mono font-medium">{{if .BrowserConfig.Kiosk}}Enabled{{else}}Disabled{{end}}</dd>
                </div>
                <div class="flex justify-between items-center py-0.5">
                    <dt class="text-base-content/70">Engine</dt>
                    <dd class="font-mono font-medium">Chromium CDP</dd>
                </div>
            </dl>

            <div class="text-[11px] text-base-content/60 font-mono truncate border-t border-base-200 pt-2">
                Auto-start &amp; Watchdog Active
            </div>
        </div>
    </div>

    <!-- Card 4: Host System -->
    <div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl">
        <div class="card-body p-4 sm:p-5 flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-lg bg-info/10 text-info flex items-center justify-center shrink-0">
                        <span class="app-icon icon-chip w-4 h-4" aria-hidden="true"></span>
                    </div>
                    <h2 class="card-title text-sm font-semibold m-0">Host &amp; Runtime</h2>
                </div>
                <span class="badge badge-info badge-sm font-mono">{{.OS}}/{{.Arch}}</span>
            </div>

            <dl class="flex flex-col gap-1.5 text-xs">
                <div class="flex justify-between items-center py-0.5 border-b border-base-200/60">
                    <dt class="text-base-content/70">Hostname</dt>
                    <dd class="font-mono font-medium truncate max-w-[140px]" title="{{.Hostname}}">{{.Hostname}}</dd>
                </div>
                <div class="flex justify-between items-center py-0.5 border-b border-base-200/60">
                    <dt class="text-base-content/70">Runtime</dt>
                    <dd class="font-mono font-medium">{{.GoVersion}}</dd>
                </div>
                <div class="flex justify-between items-center py-0.5 border-b border-base-200/60">
                    <dt class="text-base-content/70">Uptime</dt>
                    <dd class="font-mono font-medium text-success">{{.Uptime}}</dd>
                </div>
                <div class="flex justify-between items-center py-0.5">
                    <dt class="text-base-content/70">Started</dt>
                    <dd class="font-mono font-medium truncate max-w-[140px]" title="{{.StartTime.Format "2006-01-02 15:04:05"}}">{{.StartTime.Format "15:04:05"}}</dd>
                </div>
            </dl>

            <div class="text-[11px] text-base-content/60 font-mono truncate border-t border-base-200 pt-2">
                Status: Operational
            </div>
        </div>
    </div>

</div>

<!-- WebSocket Message Log Section -->
<div class="card bg-base-100 border border-base-200 shadow-sm rounded-2xl mt-6">
    <div class="card-body p-4 sm:p-5">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0">
                    <span class="app-icon icon-bolt w-4 h-4" aria-hidden="true"></span>
                </div>
                <div>
                    <h3 class="card-title text-sm font-semibold m-0">WebSocket Message Log</h3>
                    <p class="text-xs text-base-content/60 m-0">Real-time incoming and outgoing broker telemetry</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <span class="badge badge-sm badge-outline font-mono">{{len .Messages}} entries</span>
                <span class="badge badge-primary badge-outline badge-sm">Live Stream</span>
            </div>
        </div>

        {{if .Messages}}
        <div class="overflow-x-auto overflow-y-auto max-h-96 rounded-xl border border-base-200">
            <table class="table table-zebra table-pin-rows table-xs sm:table-sm w-full font-mono">
                <thead>
                    <tr>
                        <th class="w-24">Time</th>
                        <th class="w-16">Dir</th>
                        <th class="w-24">Type</th>
                        <th class="w-28">Source</th>
                        <th class="w-28">Target</th>
                        <th class="w-24">Session</th>
                        <th>Payload Data</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .Messages}}
                    <tr class="hover">
                        <td class="text-base-content/70 whitespace-nowrap">{{.Timestamp.Format "15:04:05.000"}}</td>
                        <td>
                            {{if eq .Direction "in"}}
                            <span class="badge badge-info badge-xs uppercase font-semibold">IN</span>
                            {{else if eq .Direction "out"}}
                            <span class="badge badge-secondary badge-xs uppercase font-semibold">OUT</span>
                            {{else}}
                            <span class="badge badge-warning badge-xs uppercase font-semibold">SYS</span>
                            {{end}}
                        </td>
                        <td><span class="badge badge-ghost badge-xs">{{.Type}}</span></td>
                        <td class="text-base-content/80 truncate max-w-[110px]" title="{{.Source}}">{{.Source}}</td>
                        <td class="text-base-content/80 truncate max-w-[110px]" title="{{.Target}}">{{.Target}}</td>
                        <td class="text-base-content/60 truncate max-w-[100px]" title="{{.Session}}">{{.Session}}</td>
                        <td class="font-normal truncate max-w-xs xl:max-w-md text-base-content" title="{{.Data}}">{{.Data}}</td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
        {{else}}
        <div class="alert alert-info shadow-sm text-xs font-mono">
            <span class="app-icon icon-external-link w-4 h-4 shrink-0" aria-hidden="true"></span>
            <span>No WebSocket messages received yet. Waiting for broker traffic...</span>
        </div>
        {{end}}
    </div>
</div>
