<!-- DaisyUI Theme & Mode Selector Modal Dialog -->
<dialog id="theme-modal-dialog" class="modal modal-bottom sm:modal-middle" aria-labelledby="theme-modal-title" role="dialog" aria-modal="true">
    <div class="modal-box w-11/12 max-w-4xl max-h-[92vh] flex flex-col p-4 sm:p-5 gap-3 overflow-hidden app-panel">
        
        <!-- Modal Header -->
        <div class="flex items-center justify-between shrink-0">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-primary/15 border border-primary/25 text-primary flex items-center justify-center shrink-0 shadow-sm">
                    <span class="app-icon icon-palette w-5 h-5 text-primary" aria-hidden="true"></span>
                </div>
                <div>
                    <h3 id="theme-modal-title" class="text-base sm:text-lg font-bold app-title flex items-center gap-2">
                        Design &amp; Farbschema
                    </h3>
                    <p class="text-xs app-meta-text">Anzeigemodus und DaisyUI Theme mit Live-Vorschau anpassen</p>
                </div>
            </div>

            <!-- Close Button -->
            <button type="button" class="btn btn-sm btn-circle btn-ghost" id="theme-modal-close" aria-label="Dialog schließen" title="Schließen">
                <span class="app-icon icon-x-mark w-4 h-4" aria-hidden="true"></span>
            </button>
        </div>

        <!-- Section: Modus & Live-Test Preview (Fixed, non-scrolling) -->
        <div class="card card-bordered bg-base-100/80 border-base-300/60 shadow-sm p-3 sm:p-3.5 shrink-0 space-y-2.5">
            <!-- Mode & Status Header Row -->
            <div class="flex flex-wrap items-center justify-between gap-2.5">
                <!-- Mode Radios -->
                <div class="flex items-center gap-2">
                    <span class="text-xs font-semibold uppercase tracking-wider app-metric-label">Modus:</span>
                    <div class="join" id="theme-mode-radios" role="radiogroup" aria-label="Anzeigemodus auswählen">
                        <button type="button" data-mode="auto" id="theme-mode-btn-auto" class="btn btn-xs sm:btn-sm join-item theme-mode-btn btn-primary app-btn flex items-center gap-1.5" role="radio" aria-checked="true" title="Folgt den Systemeinstellungen des Betriebssystems">
                            <span class="app-icon icon-sun-moon w-3.5 h-3.5 shrink-0" aria-hidden="true"></span>
                            <span>Auto</span>
                        </button>
                        <button type="button" data-mode="lightmode" id="theme-mode-btn-light" class="btn btn-xs sm:btn-sm join-item theme-mode-btn btn-ghost app-btn flex items-center gap-1.5" role="radio" aria-checked="false" title="Immer helles Farbschema erzwingen">
                            <span class="app-icon icon-sun-moon w-3.5 h-3.5 shrink-0" aria-hidden="true"></span>
                            <span>Hell</span>
                        </button>
                        <button type="button" data-mode="darkmode" id="theme-mode-btn-dark" class="btn btn-xs sm:btn-sm join-item theme-mode-btn btn-ghost app-btn flex items-center gap-1.5" role="radio" aria-checked="false" title="Immer dunkles Farbschema erzwingen">
                            <span class="app-icon icon-sun-moon w-3.5 h-3.5 shrink-0" aria-hidden="true"></span>
                            <span>Dunkel</span>
                        </button>
                    </div>
                </div>

                <!-- Active Mode & Theme Title -->
                <div class="flex items-center gap-2">
                    <span id="theme-mode-summary-badge" class="badge badge-sm badge-outline font-mono text-[11px] gap-1 py-2.5">
                        <span id="theme-mode-summary-text">Helle Themes</span>: <strong id="theme-count-visible">14</strong>
                    </span>
                    <span class="badge badge-sm badge-primary font-mono text-[11px] py-2.5">
                        Theme: <strong id="live-preview-theme-title" class="ml-1 font-bold">Corporate</strong>
                    </span>
                </div>
            </div>

            <!-- Live-Test Preview Components -->
            <div id="theme-live-preview-box" class="bg-base-200/50 rounded-xl p-2.5 sm:p-3 border border-base-300/40 space-y-2">
                <!-- Buttons Row -->
                <div class="flex flex-wrap items-center gap-1.5">
                    <button type="button" class="btn btn-xs sm:btn-sm btn-primary">Primary</button>
                    <button type="button" class="btn btn-xs sm:btn-sm btn-secondary">Secondary</button>
                    <button type="button" class="btn btn-xs sm:btn-sm btn-accent">Accent</button>
                    <button type="button" class="btn btn-xs sm:btn-sm btn-neutral">Neutral</button>
                    <button type="button" class="btn btn-xs sm:btn-sm btn-ghost">Ghost</button>
                    <button type="button" class="btn btn-xs sm:btn-sm btn-outline btn-primary">Outline</button>
                </div>

                <!-- Badges Row -->
                <div class="flex flex-wrap items-center gap-1.5">
                    <span class="badge badge-primary badge-sm">Primary</span>
                    <span class="badge badge-secondary badge-sm">Secondary</span>
                    <span class="badge badge-accent badge-sm">Accent</span>
                    <span class="badge badge-success badge-sm">Online</span>
                    <span class="badge badge-warning badge-sm">Syncing</span>
                    <span class="badge badge-error badge-sm">Fehler</span>
                    <span class="badge badge-info badge-sm">Info</span>
                    <span class="badge badge-outline badge-sm font-mono">12.345ms</span>
                </div>

                <!-- Form Controls Row -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 items-center bg-base-100/70 p-2 rounded-lg border border-base-300/40">
                    <div class="flex items-center gap-2">
                        <input type="text" class="input input-xs input-bordered w-full font-mono text-[11px] app-input" value="wsbroker://display-01" readonly />
                    </div>
                    <div class="flex items-center justify-around gap-2">
                        <label class="label cursor-pointer gap-1.5 py-0 select-none">
                            <input type="checkbox" class="checkbox checkbox-primary checkbox-xs" checked />
                            <span class="label-text text-xs">NTP Sync</span>
                        </label>
                        <label class="label cursor-pointer gap-1.5 py-0 select-none">
                            <input type="checkbox" class="toggle toggle-secondary toggle-xs" checked />
                            <span class="label-text text-xs">Kiosk</span>
                        </label>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-[10px] text-base-content/70 font-mono">Scale:</span>
                        <input type="range" min="0" max="100" value="100" class="range range-xs range-accent flex-1" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Section: Themes Grid (Scrollable) -->
        <div class="card card-bordered bg-base-100/60 border-base-300/60 shadow-sm p-3 sm:p-3.5 flex-1 min-h-[220px] flex flex-col overflow-hidden">
            <div class="flex items-center justify-between pb-2 shrink-0">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-bold uppercase tracking-wider app-metric-label">Verfügbare DaisyUI Themes</span>
                </div>
                <span class="text-[11px] app-meta-text">Klicken zum sofortigen Testen &amp; Auswählen</span>
            </div>
            
            <div class="theme-scroll-area flex-1 overflow-y-auto pr-1 custom-scrollbar w-full">
                <div id="theme-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 w-full">
                    <!-- Populated dynamically by theme-selector.js -->
                </div>
            </div>
        </div>

        <!-- Modal Footer -->
        <div class="flex items-center justify-between pt-1 shrink-0">
            <button type="button" id="theme-reset-btn" class="btn btn-sm btn-ghost app-btn text-xs text-base-content/70 hover:text-base-content" title="Auf Standard-Design zurücksetzen">
                Standard wiederherstellen
            </button>
            <button type="button" id="theme-apply-close-btn" class="btn btn-sm btn-primary app-btn text-xs font-semibold px-5" title="Auswahl übernehmen und Dialog schließen">
                Fertig
            </button>
        </div>

    </div>
    
    <!-- Modal Backdrop -->
    <form method="dialog" class="modal-backdrop">
        <button>close</button>
    </form>
</dialog>
